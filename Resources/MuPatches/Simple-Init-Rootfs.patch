diff --git a/src/config-uefi.h b/src/config-uefi.h
index 440d90d7..ba3ad119 100644
--- a/src/config-uefi.h
+++ b/src/config-uefi.h
@@ -16,3 +16,36 @@
 #define FT_CONFIG_OPTIONS_H "libs/freetype-uefi/ftoption.h"
 #define LV_CONF_PATH        lv_conf.h
 #define LODEPNG_NO_COMPILE_DISK
+
+/*
+ * EDK2's CLANGPDB Tool Chain builds for aarch64-unknown-windows-msvc purely
+ * to get PE/COFF Objects out of Clang. That Target defines the usual Windows
+ * Identity Macros, and EDK2 adds "-D __MINGW32__=1" on Top so its own Headers
+ * treat the Compiler as GCC-like. None of that describes the Environment this
+ * Code actually runs in: it is Firmware, and the POSIX Surface it wants comes
+ * from libs/compatible rather than from Windows or from MinGW.
+ *
+ * Left defined, vendored Third Party Code takes its Windows Path and either
+ * calls a Runtime that is not linked in (libs/stb/stb_leakcheck.h reaches for
+ * __mingw_fprintf) or skips the POSIX Header it needs (libs/mxml/mxml-file.c
+ * guards <unistd.h> behind !_WIN32, then calls read and write).
+ *
+ * Every Module in this Tree force-includes this Header before anything else,
+ * so undefining them here reaches all of them and no EDK2 Module.
+ *
+ * _WIN64 is deliberately LEFT ALONE, because Third Party Code reads the two
+ * Macros as different Claims. _WIN32 asserts that the Operating System is
+ * Windows, which is false here. _WIN64 asserts that the Data Model is LLP64,
+ * which is true here and is the whole Reason this File exists. FreeType is the
+ * clear Example: compiler-macros.h picks its Integer to Pointer Cast off
+ * _WIN64 with the Comment "only 64bit Windows uses the LLP64 data model", and
+ * with _WIN64 undefined it casts through a 32-bit unsigned long and truncates
+ * every Pointer it stores.
+ */
+#ifdef _WIN32
+#undef _WIN32
+#endif
+
+#ifdef __MINGW32__
+#undef __MINGW32__
+#endif
