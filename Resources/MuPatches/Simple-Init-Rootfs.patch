@@ -1,3 +1,20 @@
+[BuildOptions]
+  #
+  # EDK2's CLANGPDB Tool Chain builds for a Windows Target, which turns on
+  # Clang's Microsoft Compatibility Mode. That Mode resolves a quoted Include
+  # against the Directory of every File on the Include Stack rather than just
+  # the Directory of the including File, so "include/gui/lua.h" shadows the
+  # Lua Header that "include/xlua.h" asks for. Standard Search Rules pick the
+  # right one.
+  #
+  #
+  # Third Party Code in this Tree does not build clean under EDK2's -Werror.
+  # These relax Cosmetic Warning Classes only. -Werror itself stays on, and
+  # Warnings that point at real Portability Problems, such as an implicitly
+  # declared Function standing for a missing C Library Routine, stay Errors.
+  #
+  *_CLANGPDB_AARCH64_CC_FLAGS = -fno-ms-compatibility -Wno-self-assign -Wno-non-literal-null-conversion -Wno-unused-function -Wno-sign-compare -Wno-misleading-indentation -Wno-tautological-pointer-compare -Wno-string-plus-int -Wno-enum-conversion -Wno-pointer-sign -Wno-unused-but-set-variable
+
