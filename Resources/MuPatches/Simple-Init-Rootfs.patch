diff --git a/libs/compatible/include/arch/aarch64/bits/alltypes.h b/libs/compatible/include/arch/aarch64/bits/alltypes.h
index 0f4c6538..876585cd 100644
--- a/libs/compatible/include/arch/aarch64/bits/alltypes.h
+++ b/libs/compatible/include/arch/aarch64/bits/alltypes.h
@@ -1,6 +1,19 @@
+/*
+ * AArch64 has two Data Models. ELF Targets are LP64, where long is 64-bit.
+ * The Windows Target that EDK2's CLANGPDB Tool Chain uses is LLP64, where
+ * long is 32-bit and only long long is 64-bit. musl parameterises every
+ * Type in this File through the three Macros below for exactly this Reason,
+ * so selecting them by the actual Size of long covers both.
+ */
+#if defined(__SIZEOF_LONG__) && __SIZEOF_LONG__ == 4
+#define _Addr long long
+#define _Int64 long long
+#define _Reg long long
+#else
 #define _Addr long
 #define _Int64 long
 #define _Reg long
+#endif
 
 #if __AARCH64EB__
 #define __BYTE_ORDER 4321
@@ -8,7 +21,11 @@
 #define __BYTE_ORDER 1234
 #endif
 
+#if defined(__SIZEOF_LONG__) && __SIZEOF_LONG__ == 4
+#define __LONG_MAX 0x7fffffffL
+#else
 #define __LONG_MAX 0x7fffffffffffffffL
+#endif
 
 #ifndef __cplusplus
 #if defined(__NEED_wchar_t) && !defined(__DEFINED_wchar_t)
diff --git a/libs/compatible/malloc.c b/libs/compatible/malloc.c
index f550e40d..b3862a9d 100644
--- a/libs/compatible/malloc.c
+++ b/libs/compatible/malloc.c
@@ -167,21 +167,32 @@ free(void *Ptr)
 {
 	CPOOL_HEAD   *Head;
 
+	//
+	// free(NULL) is defined to do nothing, and this Test has to come BEFORE
+	// BASE_CR derives a Pointer from Ptr. Subtracting from a Null Pointer is
+	// Undefined Behaviour, so with -flto -Oz the Compiler is entitled to infer
+	// from that Arithmetic that Ptr cannot be Null, and it then deletes the
+	// "if (Ptr != NULL)" Guard that used to sit below. The Result was that
+	// free(NULL) read Head->Signature at Ptr - 32 + 0x10, faulting on
+	// 0xFFFFFFFFFFFFFFF0. Lua reaches this through l_alloc, which calls
+	// free(Ptr) whenever nsize is 0, from luaH_resize during luaopen_base, so
+	// the GUI aborted before it drew anything. realloc below already orders
+	// its own Test correctly.
+	//
+	if (Ptr == NULL) return;
+
 	Head = BASE_CR(Ptr, CPOOL_HEAD, Data);
-	assert(Head != NULL);
 	DEBUG((DEBUG_POOL, "free(%p): Head: %p\n", Ptr, Head));
 
-	if(Ptr != NULL) {
-		if (Head->Signature == CPOOL_HEAD_SIGNATURE) {
-			(void) RemoveEntryList((LIST_ENTRY *)Head);   // Remove this node from the malloc pool
-			(void) gBS->FreePool (Head);                  // Now free the associated memory
-		}
-		else {
-			errno = EFAULT;
-			DEBUG((DEBUG_ERROR, "ERROR free(0x%p): Signature is 0x%8X, expected 0x%8X\n",
-				Ptr, Head->Signature, CPOOL_HEAD_SIGNATURE));
-			abort();
-		}
+	if (Head->Signature == CPOOL_HEAD_SIGNATURE) {
+		(void) RemoveEntryList((LIST_ENTRY *)Head);   // Remove this node from the malloc pool
+		(void) gBS->FreePool (Head);                  // Now free the associated memory
+	}
+	else {
+		errno = EFAULT;
+		DEBUG((DEBUG_ERROR, "ERROR free(0x%p): Signature is 0x%8X, expected 0x%8X\n",
+			Ptr, Head->Signature, CPOOL_HEAD_SIGNATURE));
+		abort();
 	}
 	DEBUG((DEBUG_POOL, "free Done\n"));
 }
diff --git a/libs/compatible/uefi-gaps.c b/libs/compatible/uefi-gaps.c
new file mode 100644
index 00000000..c8ad9cea
--- /dev/null
+++ b/libs/compatible/uefi-gaps.c
@@ -0,0 +1,128 @@
+/*
+ * Routines this Compatibility Layer declares in its own Headers but never
+ * implements, plus the POSIX File Descriptor Calls that Third Party Code in
+ * this Tree reaches for. Nothing here existed before, so every Definition is
+ * a strong one; stub.c keeps the weak ones it needs to override.
+ *
+ * The File Descriptor Calls fail with ENOSYS on Purpose. Firmware has no File
+ * Descriptor Table, and Simple Init does its real Input and Output through the
+ * fs_ Layer in src/filesystem rather than through these. They are referenced
+ * only by Paths that are not taken here: json-c's json_util.c, mxml's
+ * mxml-file.c and src/filesystem/utils.c.
+ *
+ * Note that stub.c's fwrite treats its Buffer as NUL terminated, so every
+ * Buffer handed to it below is terminated.
+ */
+
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include "stdio.h"
+#include "stdlib.h"
+#include "string.h"
+#include "errno.h"
+#include "time.h"
+#include "unistd.h"
+#include "fcntl.h"
+
+extern ssize_t full_write (int fd, void *data, size_t len);
+
+int fputc (int c, FILE *f) {
+	unsigned char b[2];
+	b[0] = (unsigned char)c, b[1] = 0;
+	fwrite (b, 1, 1, f);
+	return (int)b[0];
+}
+
+int putc (int c, FILE *f) {
+	return fputc (c, f);
+}
+
+int puts (const char *s) {
+	if (!s) return EOF;
+	if (*s) fwrite (s, 1, strlen (s), stdout);
+	fwrite ("\n", 1, 1, stdout);
+	return 0;
+}
+
+void *bsearch (
+	const void *key,
+	const void *base,
+	size_t      nmemb,
+	size_t      size,
+	int       (*compar)(const void *, const void *)
+) {
+	const char *b = base;
+	while (nmemb > 0) {
+		size_t      mid = nmemb / 2;
+		const char *cur = b + mid * size;
+		int         cmp = compar (key, cur);
+		if (cmp == 0) return (void *)cur;
+		if (cmp > 0) b = cur + size, nmemb -= mid + 1;
+		else nmemb = mid;
+	}
+	return NULL;
+}
+
+/* asctime is called by this Layer's own ctime, in time.c. */
+char *asctime (const struct tm *tm) {
+	static const char *const wday[] = {
+		"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
+	};
+	static const char *const mon[] = {
+		"Jan", "Feb", "Mar", "Apr", "May", "Jun",
+		"Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+	};
+	static char buf[32];
+	if (!tm) return NULL;
+	if (tm->tm_wday < 0 || tm->tm_wday > 6) return NULL;
+	if (tm->tm_mon  < 0 || tm->tm_mon  > 11) return NULL;
+	snprintf (
+		buf, sizeof (buf), "%s %s %2d %02d:%02d:%02d %d\n",
+		wday[tm->tm_wday], mon[tm->tm_mon], tm->tm_mday,
+		tm->tm_hour, tm->tm_min, tm->tm_sec, tm->tm_year + 1900
+	);
+	return buf;
+}
+
+int usleep (unsigned useconds) {
+	if (gBS) gBS->Stall (useconds);
+	return 0;
+}
+
+static int unsupported (const char *name) {
+	DEBUG ((EFI_D_ERROR, "try to call unsupported %a\n", name));
+	errno = ENOSYS;
+	return -1;
+}
+
+int open (const char *path __attribute__((unused)), int flags __attribute__((unused)), ...) {
+	return unsupported ("open");
+}
+
+int close (int fd __attribute__((unused))) {
+	return unsupported ("close");
+}
+
+ssize_t read (
+	int    fd  __attribute__((unused)),
+	void  *buf __attribute__((unused)),
+	size_t len __attribute__((unused))
+) {
+	return unsupported ("read");
+}
+
+ssize_t write (
+	int         fd  __attribute__((unused)),
+	const void *buf __attribute__((unused)),
+	size_t      len __attribute__((unused))
+) {
+	return unsupported ("write");
+}
+
+ssize_t full_write (
+	int    fd   __attribute__((unused)),
+	void  *data __attribute__((unused)),
+	size_t len  __attribute__((unused))
+) {
+	return unsupported ("full_write");
+}
