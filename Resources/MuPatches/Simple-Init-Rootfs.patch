diff --git a/libs/libzip/lib/zip_source_file_uefi.c b/libs/libzip/lib/zip_source_file_uefi.c
new file mode 100644
index 00000000..8f6f778e
--- /dev/null
+++ b/libs/libzip/lib/zip_source_file_uefi.c
@@ -0,0 +1,25 @@
+/*
+ * zip_source_file_create opens an Archive by Path Name through stdio. That
+ * cannot work in Firmware: the Compatibility Layer's fopen returns ENOSYS, and
+ * the Files that carry the real Implementation, zip_source_file_stdio.c and
+ * zip_source_file_stdio_named.c, need fileno, fstat, stat, rename and remove,
+ * none of which exist here. Simple Init opens Archives through
+ * zip_source_buffer and its own fs_ Layer instead, so this reports that the
+ * Operation is not supported rather than pulling that Dependency Chain in.
+ */
+
+#include "zipint.h"
+
+ZIP_EXTERN zip_source_t *
+zip_source_file_create (
+	const char   *fname,
+	zip_uint64_t  start,
+	zip_int64_t   length,
+	zip_error_t  *error
+) {
+	(void)fname;
+	(void)start;
+	(void)length;
+	zip_error_set (error, ZIP_ER_OPNOTSUPP, 0);
+	return NULL;
+}
